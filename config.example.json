{
  "sip": {
    "listen_addr": "0.0.0.0",
    "listen_port": 5060,
    "external_ip": "YOUR_PUBLIC_IP",
    "external_port": 5060,
    "tls_port": 5061,
    "tls_cert": "",
    "tls_key": "",
    "rtp_port_min": 10000,
    "rtp_port_max": 10200
  },
  "uplink": {
    "host": "sip.provider.com",
    "port": 5060,
    "username": "your_sip_username",
    "password": "your_sip_password",
    "transport": "udp",
    "expiry": 300,
    "filter_called_no": true
  },
  "users": [
    { "username": "100", "password": "changeme100" },
    { "username": "101", "password": "changeme101" },
    { "username": "102", "password": "changeme102" }
  ],
  "max_calls": 3,
  "auth_guard": {
    "enabled": true,
    "max_guesses": 10,
    "window": 300,
    "block_time": 3600
  },
  "dialplan": {
    "internal_max_digits": 3
  },
  "recording": {
    "enabled": true,
    "dir": "./recordings",
    "announcement": "./announcement.wav",
    "answer_first": true
  },
  "post_call": {
    "script": ""
  },
  "voicemail": {
    "enabled": true,
    "unavailable_announcement": "./unavailable.wav",
    "silence_timeout": 10,
    "max_duration": 120
  },
  "business_hours": {
    "enabled": true,
    "timezone": "Europe/Prague",
    "days": ["mon", "tue", "wed", "thu", "fri"],
    "start_time": "10:00",
    "end_time": "17:00",
    "outside_hours_announcement": "./outside_hours.wav"
  },
  "vacation": {
    "announcement": "./vacation.wav",
    "periods": [
      { "from": "2026-12-23", "to": "2027-01-03", "announcement": "./vacation_2027-01-04.wav" }
    ]
  }
}
